<div class="auth-container">

<div class="auth-card">
<h2 class="auth-title">Agregar Juego</h2>

<form asp-action="Insertar" method="post" enctype="multipart/form-data" class="auth-form">

<!-- INPUTS -->
<div class="form-group">
    <input name="titulo" type="text" placeholder="Título" class="form-input" required />
</div>

<div class="form-group">
    <input name="descripcion" type="text" placeholder="Descripción" class="form-input" required />
</div>

<div class="form-group">
    <input name="precio" type="number" placeholder="Precio" class="form-input" required />
</div>

<!-- FILE -->
<div class="form-group file-group">
    <label class="form-label">Imagen del juego</label>
    <input type="file" name="imagen" class="form-file" accept="image/*" />
</div>

<!-- CHECKBOX -->
<div class="form-group">
    <p class="form-label">Géneros</p>

    <div class="checkbox-group">
        @foreach (var genero in Model.Generos)
        {
            <label class="checkbox-item">
                <input type="checkbox" name="GenerosSeleccionados" value="@genero.GeneroID" />
                <span>@genero.NombreGenero</span>
            </label>
        }
    </div>
</div>

<!-- BUTTON -->
<button type="submit" class="btn-submit">Registrar Juego</button>

</form>
</div>

</div>
</div>
    </body>
</html>


