@{
}

@model List<Erazof.Domain.BibliotecaUsuario>


<table border="1">
    <thead>
        <tr>
            <th>UsuarioID</th>
            <th>Username</th>
            <th>Email</th>
            <th>JuegoID</th>
            <th>Titulo</th>
            <th>Precio</th>
            <th>FechaCompra</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserId</td>
                <td>@item.UserName</td>
                <td>@item.Email</td>
                <td>@item.GameID</td>
                <td>@item.titulo</td>
                <td>@item.precio</td>
                <td>@item.FechaCompra</td>

            </tr>
        }
           
    </tbody>
</table>