@{
    Layout = "_Layout";
}
@model List<Erazof.Domain.BibliotecaUsuario>

<html>
<head>
    <link rel="stylesheet" href="/css/styleBiblioteca.css" />
</head>
<body>

<div class="biblioteca-container">
    <div class="biblioteca-header">
        <h2>Biblioteca de Usuario</h2>
        <p>Todos los juegos comprados</p>
    </div>

    <div class="biblioteca-grid">
        @foreach (var item in Model)
        {
            <div class="biblioteca-card">
                <div class="card-image">
                    <img src="@item.precio" alt="@item.titulo" />
                </div>
                <div class="card-info">
                    <h3>@item.titulo</h3>
                    <p class="card-user">@item.UserName</p>
                    <p class="card-precio">$@item.precio</p>
                    <p class="card-fecha">Comprado: @item.FechaCompra.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-biblioteca">
            <h3>No hay juegos en la biblioteca</h3>
        </div>
    }
</div>

</body>
</html>