@{
    Layout = "_Layout";
}
@model Erazof.WebApp.Models.HomeViewModel;

<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/StyleSwiper.css" />
</head>
<body>

<div class="contenedor-generos">
    @foreach (var g in Model.ListaGeneros)
    {
        <div class="padre-section">
            <section>
                <div class="section">
                    <div class="cabecera-section">
                        <p class="neon-text">@g.NombreGenero</p>
                    </div>
                    <div class="swiper mySwiper-@g.GeneroID">
                        <div class="swiper-wrapper">
                            @foreach (var c in Model.ListaSwiper)
                            {
                                @if (c.generoid == g.GeneroID)
                                {
                                    @if (c.portada == true)
                                    {
                                        <div class="swiper-slide">
                                            <div class="prueba">
                                                <a href="Juegos/Detalle/@c.juegoid" class="pruebaenlace">
                                                    <img src="@c.url" class="pruebaimg" alt="@c.titulo" />
                                                </a>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        </div>
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                        <div class="swiper-pagination"></div>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
    @foreach (var g in Model.ListaGeneros)
    {
        <text>
        var swiper@(g.GeneroID) = new Swiper(".mySwiper-@g.GeneroID", {
            slidesPerView: 4,
            spaceBetween: 20,
            loop: true,
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
            },
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
            breakpoints: {
                320: {
                    slidesPerView: 1,
                },
                640: {
                    slidesPerView: 2,
                },
                1024: {
                    slidesPerView: 3,
                },
                1280: {
                    slidesPerView: 4,
                }
            }
        });
        </text>
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>