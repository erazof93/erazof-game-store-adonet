@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model List<Erazof.Domain.Usuario>
<table>
    <thead>
        <tr>
            <th>UsuarioID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Password</th>
            <th>FechaReg</th>
            <th>RolID</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.UsuarioID</td>
                <td>@usuario.Username</td>
                <td>@usuario.Email</td>
                <td>@usuario.Password</td>
                <td>@usuario.FechaReg</td>
                <td>@usuario.RolID.NombreRol</td>
                <td>
                    <a asp-controller="Usuario" asp-action="Edit" asp-route-id="@usuario.UsuarioID" class="btn btn-warning">
                        Modificar
                    </a>
                </td>
                <td>
                    <a asp-controller="Usuario" asp-action="Delete" asp-route-id="@usuario.UsuarioID" class="btn btn-danger">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
