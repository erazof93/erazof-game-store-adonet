@{
}
@model Erazof.Domain.Usuario

<form action="/Usuario/Edit" method="post">
    @* Importante: El AntiForgeryToken es necesario si tu controlador tiene [ValidateAntiForgeryToken] *@
    @* @Html.AntiForgeryToken() *@

    
    <input type="hidden" name="UsuarioID" value="@Model.UsuarioID" />

    <div class="input-group">
        <label>Usuario:</label>
        <input type="text" name="Username" value="@Model.Username" placeholder="Usuario" required />
    </div>

    <div class="input-group">
        <label>Correo:</label>
        <input type="email" name="Email" value="@Model.Email" placeholder="Correo" required />
    </div>

    <div class="input-group">
        <label>Contraseña:</label>
        <input type="password" name="Password" value="@Model.Password" placeholder="Contraseña" required />
    </div>

    <div style="margin-top: 20px;">
        <button type="submit">Actualizar</button>
        <a href="/Usuario/Index">Cancelar</a>
    </div>
</form>