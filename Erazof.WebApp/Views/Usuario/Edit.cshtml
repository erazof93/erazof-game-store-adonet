@{
}
@model Erazof.Domain.Usuario
<html>
<head>
    <link rel="stylesheet" href="~/css/styleActualizar.css" />
</head>
<body>

    <div class="form-container">

        <div class="login-box">
            <h2>Editar Usuario</h2>

            <form action="/Usuario/Edit" method="post">

                <input type="hidden" name="UsuarioID" value="@Model.UsuarioID" />

                <div class="input-group">
                    <input type="text" name="Username" value="@Model.Username" placeholder=" " required />
                    <label>Usuario</label>
                </div>

                <div class="input-group">
                    <input type="email" name="Email" value="@Model.Email" placeholder=" " required />
                    <label>Correo</label>
                </div>

                <div class="input-group">
                    <input type="password" name="Password" value="@Model.Password" placeholder=" " required />
                    <label>Contraseña</label>
                </div>

                <button type="submit">Actualizar</button>

                <a href="/Usuario/Index" class="btn-cancelar">Cancelar</a>

            </form>
        </div>

    </div>

</body>
</html>