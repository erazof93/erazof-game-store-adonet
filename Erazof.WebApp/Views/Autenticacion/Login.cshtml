@{
}

@model Erazof.Application.DTOs.Request.LoginRequest

<html>
    <head>  
        <link rel="stylesheet" type="text/css" href="~/css/StyleLogin.css">
    </head>
    <body>

    <h2>Login GamesFull</h2>


    <div class="login-box">
        <h2>Iniciar sesión</h2>

        <form asp-action="Login" method="post">
            <div class="input-group">
                <input name="UserOrEmail" placeholder="Ingrese un correo o Usuario" required>
            </div>

            <div class="input-group">
                <input name="Password" type="password" placeholder="Contraseña" required>
            </div>

            <button type="submit">Ingresar</button>

                <a href="/Usuario/Create"><p class="register">¿Desea registrarse?</p></a>
        </form>

            @if (ViewBag.Error != null)
            {
                <div style="
                    margin-top: 15px;
                    padding: 10px;
                    background-color: red;
                    color: white;
                    border-radius: 5px;
                    text-align: center;
                    font-size: 14px;
                    ">
                    @ViewBag.Error
                </div>
            }
    </div>

    </body>
</html>


